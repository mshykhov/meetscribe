# HuggingFace token for pyannote speaker diarization
# Get it at: https://huggingface.co/settings/tokens
# Accept license at: https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=hf_xxx

# Path to claude CLI (requires Claude Code subscription)
CLAUDE_CLI=claude

# Folder where OBS saves recordings
WATCH_DIR=~/Videos/OBS

# Output folder for processed meetings
OUTPUT_DIR=~/docs/video

# Whisper model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=medium

# Language (ru, en, etc.) or leave empty for auto-detect
LANGUAGE=

# Max speakers for diarization (0 = auto)
MAX_SPEAKERS=0

# Claude model for summarization
CLAUDE_MODEL=claude-sonnet-4-6

# === Transcribe backend ===
# Choose which provider runs transcription:
#   "local"  - whisperx-mlx (Apple Silicon GPU, private, slowest)
#   "openai" - OpenAI Whisper API (paid, reference quality)
#   "groq"   - Groq Whisper API (free tier, ~10x faster than OpenAI)
TRANSCRIBE_BACKEND=local

# Used only when TRANSCRIBE_BACKEND=openai
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Used only when TRANSCRIBE_BACKEND=groq
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# === Summary backend ===
# Choose summary provider:
#   "claude_code" - Claude Code CLI (subscription, default)
#   "openai"      - OpenAI Chat Completions (paid)
#   "groq"        - Groq Chat Completions (free tier)
SUMMARY_BACKEND=claude_code

# When SUMMARY_BACKEND=claude_code: uses CLAUDE_CLI + CLAUDE_MODEL above.
# When SUMMARY_BACKEND=openai: reuses OPENAI_API_KEY above.
OPENAI_SUMMARY_MODEL=gpt-4o-mini
# When SUMMARY_BACKEND=groq: reuses GROQ_API_KEY above.
GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile

# Per-video config overrides: drop <stem>.meetscribe.toml next to a video.
# See docs/sidecar.md for the schema.
